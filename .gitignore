.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Cache
.cache/

# Cache IBGE (gerado automaticamente, não versionar)
storage/cache/cidades/*.json

