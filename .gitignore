uploads/curriculos/*.pdf
uploads/projetos/*.pdf
uploads/noticias/*
uploads/transparencia/*
uploads/docs/*

# Manter estrutura de pastas vazias
!uploads/**/.gitkeep
!storage/**/.gitkeep
